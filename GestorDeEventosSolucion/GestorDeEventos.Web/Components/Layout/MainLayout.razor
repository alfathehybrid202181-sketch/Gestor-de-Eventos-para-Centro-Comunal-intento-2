@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-light border-bottom py-2">
            <h4 class="m-0 fw-bold text-primary">Omni<span class="text-primary">Eventos</span></h4>

            <div>
                <button class="btn btn-sm btn-outline-secondary px-3" @onclick="CambiarModoOscuro">
                    @(esModoOscuro ? "Modo Claro" : "Modo Oscuro")
                </button>
            </div>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

@code {
    private bool esModoOscuro = false;

    private async Task CambiarModoOscuro()
    {
        esModoOscuro = !esModoOscuro;
        var tema = esModoOscuro ? "dark" : "light";
        await JS.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-bs-theme', '{tema}')");
    }
}