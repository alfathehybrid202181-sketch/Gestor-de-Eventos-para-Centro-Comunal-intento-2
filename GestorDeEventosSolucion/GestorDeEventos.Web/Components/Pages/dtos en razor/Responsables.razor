@page "/responsables"
@rendermode InteractiveServer
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Forms
@using GestorDeEventos.Application.Dtos.Responsable

<PageTitle>Gestión de Responsables</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Responsables</h3>
    <button class="btn btn-warning text-dark fw-bold" @onclick="AbrirFormularioNuevo">
        + Nuevo Responsable
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card mb-4 shadow-sm border-warning">
        <div class="card-header bg-warning text-dark fw-bold">
            @(itemEdicion.Id == 0 ? "Nuevo Responsable" : "Editar Responsable")
        </div>
        <div class="card-body">
            <EditForm Model="itemEdicion" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <InputText @bind-Value="itemEdicion.FullName" class="form-control" placeholder="Ej: Ernesto Olivo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Rol / Cargo</label>
                        <InputText @bind-Value="itemEdicion.Role" class="form-control" placeholder="Ej: Coordinador de Logística" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Teléfono</label>
                        <input type="text" class="form-control" placeholder="809-000-0000"
                               value="@itemEdicion.PhoneNumber"
                               @oninput="OnTelefonoInput"
                               maxlength="12" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Correo Electrónico</label>
                        <InputText @bind-Value="itemEdicion.Email" class="form-control" placeholder="correo@ejemplo.com" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@mensajeError</div>
                }

                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-secondary me-2" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (lista == null)
{
    <div class="spinner-border text-warning" role="status"></div>
}
else if (!lista.Any())
{
    <div class="alert alert-info">No hay responsables registrados actualmente.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Rol / Cargo</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in lista)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td><span class="badge bg-secondary">@item.Role</span></td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1 text-dark" @onclick="() => AbrirFormularioEditar(item)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ResponsableDto>? lista;
    private ResponsableDto itemEdicion = new();
    private bool mostrarFormulario = false;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            lista = await Http.GetFromJsonAsync<List<ResponsableDto>>("api/Responsables");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar responsables: {ex.Message}");
        }
    }

    private void AbrirFormularioNuevo()
    {
        itemEdicion = new ResponsableDto();
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(ResponsableDto item)
    {
        itemEdicion = new ResponsableDto
        {
            Id = item.Id,
            FullName = item.FullName,
            Role = item.Role,
            PhoneNumber = item.PhoneNumber,
            Email = item.Email
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void CerrarFormulario() => mostrarFormulario = false;

    private void OnTelefonoInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 10) raw = raw.Substring(0, 10);

        if (raw.Length > 6)
            itemEdicion.PhoneNumber = $"{raw.Substring(0, 3)}-{raw.Substring(3, 3)}-{raw.Substring(6)}";
        else if (raw.Length > 3)
            itemEdicion.PhoneNumber = $"{raw.Substring(0, 3)}-{raw.Substring(3)}";
        else
            itemEdicion.PhoneNumber = raw;
    }

    private async Task Guardar()
    {
        mensajeError = "";

        try
        {
            HttpResponseMessage res;

            if (itemEdicion.Id == 0)
            {
                res = await Http.PostAsJsonAsync("api/Responsables", itemEdicion);
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/Responsables/{itemEdicion.Id}", itemEdicion);
            }

            if (res.IsSuccessStatusCode)
            {
                mostrarFormulario = false;
                await Cargar();
            }
            else
            {
                var errorBody = await res.Content.ReadAsStringAsync();
                mensajeError = !string.IsNullOrWhiteSpace(errorBody)
                    ? errorBody
                    : "No se pudo guardar el responsable.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar responsable: {ex.Message}");
            mensajeError = "Ocurrió un error inesperado al guardar.";
        }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/Responsables/{id}");
            if (res.IsSuccessStatusCode)
            {
                await Cargar();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar responsable: {ex.Message}");
        }
    }
}