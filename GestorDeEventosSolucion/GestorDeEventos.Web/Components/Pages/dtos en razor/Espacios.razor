@page "/espacios"
@rendermode InteractiveServer
@inject HttpClient Http
@using GestorDeEventos.Application.Dtos.Espacio

<PageTitle>Gestión de Espacios</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Espacios</h3>
    <button class="btn btn-primary" @onclick="AbrirFormularioNuevo">
        <i class="bi bi-plus-lg"></i> Nuevo Espacio
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@(espacioEdicion.Id == 0 ? "Nuevo Espacio" : "Editar Espacio")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="espacioEdicion" OnValidSubmit="GuardarEspacio">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre del Espacio</label>
                        <InputText @bind-Value="espacioEdicion.Name" class="form-control" placeholder="Ej: Salón Principal" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ubicación</label>
                        <InputText @bind-Value="espacioEdicion.Location" class="form-control" placeholder="Ej: Nivel 1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Capacidad Máxima</label>
                        <InputNumber @bind-Value="espacioEdicion.MaxCapacity" class="form-control" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox @bind-Value="espacioEdicion.IsAvailable" class="form-check-input" id="chkDisponible" />
                            <label class="form-check-label fw-bold" for="chkDisponible">Disponible para reservas</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-secondary me-2" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (espacios == null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
}
else if (!espacios.Any())
{
    <div class="alert alert-info">No hay espacios registrados actualmente.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Ubicación</th>
                <th>Capacidad Máx.</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var espacio in espacios)
            {
                <tr>
                    <td>@espacio.Id</td>
                    <td>@espacio.Name</td>
                    <td>@espacio.Location</td>
                    <td>@espacio.MaxCapacity personas</td>
                    <td>
                        @if (espacio.IsAvailable)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No Disponible</span>
                        }
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AbrirFormularioEditar(espacio)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarEspacio(espacio.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<EspacioDto>? espacios;
    private EspacioDto espacioEdicion = new();
    private bool mostrarFormulario = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEspacios();
    }

    private async Task CargarEspacios()
    {
        try
        {
            espacios = await Http.GetFromJsonAsync<List<EspacioDto>>("api/Espacios");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar espacios: {ex.Message}");
        }
    }

    private void AbrirFormularioNuevo()
    {
        espacioEdicion = new EspacioDto { IsAvailable = true, MaxCapacity = 10 };
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(EspacioDto espacio)
    {
        espacioEdicion = new EspacioDto
        {
            Id = espacio.Id,
            Name = espacio.Name,
            Location = espacio.Location,
            MaxCapacity = espacio.MaxCapacity,
            IsAvailable = espacio.IsAvailable
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarEspacio()
    {
        if (espacioEdicion.Id == 0)
        {
            await Http.PostAsJsonAsync("api/Espacios", espacioEdicion);
        }
        else
        {
            await Http.PutAsJsonAsync($"api/Espacios/{espacioEdicion.Id}", espacioEdicion);
        }

        mostrarFormulario = false;
        await CargarEspacios();
    }

    private async Task EliminarEspacio(int id)
    {
        var respuesta = await Http.DeleteAsync($"api/Espacios/{id}");
        if (respuesta.IsSuccessStatusCode)
        {
            await CargarEspacios();
        }
    }
}