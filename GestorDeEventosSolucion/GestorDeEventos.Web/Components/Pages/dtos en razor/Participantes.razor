@page "/invitados"
@rendermode InteractiveServer
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Forms
@using GestorDeEventos.Application.Dtos.Participante
@using GestorDeEventos.Application.Dtos.Evento

<PageTitle>Gestión de Invitados</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Invitados</h3>
    <button class="btn btn-info text-white fw-bold" @onclick="AbrirFormularioNuevo">
        + Nuevo Invitado
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card mb-4 shadow-sm border-info">
        <div class="card-header bg-info text-white fw-bold">
            @(itemEdicion.Id == 0 ? "Nuevo Invitado" : "Editar Invitado")
        </div>
        <div class="card-body">
            <EditForm Model="itemEdicion" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <InputText @bind-Value="itemEdicion.FullName" class="form-control" placeholder="Ej: Ernesto Olivo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Identificación / Cédula</label>
                        <input type="text" class="form-control" placeholder="000-0000000-0"
                               value="@itemEdicion.IdentificationId"
                               @oninput="OnCedulaInput"
                               maxlength="13" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Teléfono</label>
                        <input type="text" class="form-control" placeholder="809-000-0000"
                               value="@itemEdicion.PhoneNumber"
                               @oninput="OnTelefonoInput"
                               maxlength="12" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Correo Electrónico</label>
                        <InputText @bind-Value="itemEdicion.Email" class="form-control" placeholder="correo@ejemplo.com" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Evento al que está invitado</label>
                        <InputSelect TValue="int" @bind-Value="itemEdicion.EventoId" class="form-select">
                            <option value="0">-- Selecciona un Evento --</option>
                            @if (eventos != null)
                            {
                                @foreach (var ev in eventos)
                                {
                                    <option value="@ev.Id">@ev.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@mensajeError</div>
                }

                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-secondary me-2" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="btn btn-info text-white fw-bold">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (lista == null)
{
    <div class="spinner-border text-info" role="status"></div>
}
else if (!lista.Any())
{
    <div class="alert alert-info">No hay invitados registrados actualmente.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Cédula</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Evento Asignado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in lista)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.IdentificationId</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                    <td>@(ObtenerNombreEvento(item.EventoId))</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AbrirFormularioEditar(item)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ParticipanteDto>? lista;
    private List<EventoDto>? eventos;
    private ParticipanteDto itemEdicion = new();
    private bool mostrarFormulario = false;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            lista = await Http.GetFromJsonAsync<List<ParticipanteDto>>("api/Participantes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar participantes: {ex.Message}");
        }
    }

    private async Task CargarCatalogos()
    {
        try
        {
            eventos = await Http.GetFromJsonAsync<List<EventoDto>>("api/Eventos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar eventos: {ex.Message}");
        }
    }

    private string ObtenerNombreEvento(int eventoId)
    {
        var ev = eventos?.FirstOrDefault(e => e.Id == eventoId);
        return ev != null ? ev.Name : "Sin asignar";
    }

    private void AbrirFormularioNuevo()
    {
        itemEdicion = new ParticipanteDto();
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(ParticipanteDto item)
    {
        itemEdicion = new ParticipanteDto
        {
            Id = item.Id,
            FullName = item.FullName,
            IdentificationId = item.IdentificationId,
            PhoneNumber = item.PhoneNumber,
            Email = item.Email,
            EventoId = item.EventoId
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void CerrarFormulario() => mostrarFormulario = false;

  
    private void OnCedulaInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 11) raw = raw.Substring(0, 11);

        if (raw.Length > 10)
            itemEdicion.IdentificationId = $"{raw.Substring(0, 3)}-{raw.Substring(3, 7)}-{raw.Substring(10)}";
        else if (raw.Length > 3)
            itemEdicion.IdentificationId = $"{raw.Substring(0, 3)}-{raw.Substring(3)}";
        else
            itemEdicion.IdentificationId = raw;
    }
  private void OnTelefonoInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 10) raw = raw.Substring(0, 10);

        if (raw.Length > 6)
            itemEdicion.PhoneNumber = $"{raw.Substring(0, 3)}-{raw.Substring(3, 3)}-{raw.Substring(6)}";
        else if (raw.Length > 3)
            itemEdicion.PhoneNumber = $"{raw.Substring(0, 3)}-{raw.Substring(3)}";
        else
            itemEdicion.PhoneNumber = raw;
    }

    private async Task Guardar()
    {
        mensajeError = "";

        if (itemEdicion.EventoId == 0)
        {
            mensajeError = "Por favor selecciona un evento válido.";
            return;
        }

        HttpResponseMessage res;

        if (itemEdicion.Id == 0)
        {
            res = await Http.PostAsJsonAsync("api/Participantes", itemEdicion);
        }
        else
        {
            res = await Http.PutAsJsonAsync($"api/Participantes/{itemEdicion.Id}", itemEdicion);
        }

        if (res.IsSuccessStatusCode)
        {
            mostrarFormulario = false;
            await Cargar();
        }
        else
        {
            var errorContent = await res.Content.ReadAsStringAsync();
            mensajeError = !string.IsNullOrWhiteSpace(errorContent)
                ? errorContent
                : "No se pudo guardar el registro. Verifique que los datos sean válidos o que el evento tenga aforo disponible.";
        }
    }

    private async Task Eliminar(int id)
    {
        var res = await Http.DeleteAsync($"api/Participantes/{id}");
        if (res.IsSuccessStatusCode)
        {
            await Cargar();
        }
    }
}